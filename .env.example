# =============================================================
# UK ROBO ADVISOR — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your API keys
# =============================================================

# Alpha Vantage — Market data fallback (free: 25 req/day)
# Sign up: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Open Exchange Rates — FX rates for non-GBP ETFs (free: 1000 req/month)
# Sign up: https://openexchangerates.org/signup/free
OPEN_EXCHANGE_RATES_APP_ID=your_oer_app_id_here

# Financial Modeling Prep — ETF holdings, fundamentals (free: 250 req/day)
# Sign up: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_key_here

# NewsAPI — Financial news feed (free: 100 req/day)
# Sign up: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Database (defaults to local SQLite — no config needed)
# Uncomment below for PostgreSQL if deploying:
# DATABASE_URL=postgresql://user:password@localhost:5432/robo_advisor

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true
