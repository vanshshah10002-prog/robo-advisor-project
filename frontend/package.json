        "react-dom": "^19.0.0",
        "react-router-dom": "^7.1.0",
        "zod": "^3.24.0",
        "zustand": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.63.0",
